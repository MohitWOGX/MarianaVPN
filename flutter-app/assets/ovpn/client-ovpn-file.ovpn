# This is a template config file
# Replace with your own server details before use
# Sensitive data has been removed for security

client
dev tun
dev-type tun
nobind
remote YOUR_SERVER_IP 1194 udp
remote YOUR_SERVER_IP 443 tcp

remote-cert-tls server
tls-version-min 1.2
reneg-sec 604800

cipher AES-256-CBC
auth-user-pass
auth-nocache
verb 3
push-peer-info

<ca>
REDACTED
</ca>

<cert>
REDACTED
</cert>

<key>
REDACTED
</key>

<tls-crypt-v2>
REDACTED
</tls-crypt-v2>